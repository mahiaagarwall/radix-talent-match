# Copy to .env.local and adjust. Never commit real secrets.
# Every VITE_* value is compiled into the browser bundle and is PUBLIC. Never put a
# service-role key, database password or LLM key (GROQ/GEMINI/OPENROUTER/LLM_API_KEY) here.
# Restart "npm run dev" after editing: Vite reads these files only at startup.

# demo = browser-local persistence + hand-annotated sample fixtures (no backend required)
# api  = every request goes to the FastAPI backend at VITE_API_BASE_URL
VITE_DATA_MODE=demo

# FastAPI base URL (no trailing slash). Used only when VITE_DATA_MODE=api
# or when API mode is selected on the Settings page.
VITE_API_BASE_URL=http://localhost:8000

# Request timeout in milliseconds for JSON calls (uploads get 3x this value).
VITE_API_TIMEOUT_MS=20000

# ── Company Directory (read-only, public Supabase project) ────────────────────
# Project URL: https://<project-ref>.supabase.co  (Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=
# The anon / publishable key only. The directory reads company_json, company_skill_levels,
# skill_set_master, proficiency_levels and skill_set_topics, so those tables need a SELECT policy for "anon".
VITE_SUPABASE_ANON_KEY=
# Optional: Logo.dev publishable token for sharper company logos (falls back to logo_url, then the site icon).
VITE_LOGO_DEV_PUBLISHABLE_KEY=
