# Backend environment. Copy to backend/.env and fill in real values there.
# Never commit backend/.env. Empty values below are intentional placeholders:
# this file is shared, so it must never contain real keys, passwords or connection strings.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL (https://<project-ref>.supabase.co), not a postgresql:// connection string.
SUPABASE_URL= 
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
SAVE_PARSED_RESUMES=false
# Optional direct Postgres connection (used by resume persistence).
# DATABASE_URL= postgresql://postgres.cbypziebwqriktqntnoj:akshat9540741195@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Defaults to the local
# Vite dev/preview servers when empty.
CORS_ALLOW_ORIGINS=

# ── LLM providers ───────────────────────────────────────────────────────────
# LLM_PROVIDER is tried first; the others follow LLM_PROVIDER_ORDER.
# A provider whose API key is empty is skipped. Set LLM_FALLBACK_ENABLED=false
# to use LLM_PROVIDER only.
LLM_PROVIDER=groq
LLM_FALLBACK_ENABLED=true
LLM_PROVIDER_ORDER=groq,openrouter,gemini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120B

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional tuning (defaults shown).
# LLM_TIMEOUT_SECONDS=45          # per request
# LLM_TOTAL_TIMEOUT_SECONDS=120   # whole operation, across all providers
# LLM_MAX_RETRIES=1               # extra attempts per provider for 429/5xx/timeouts (0-3)
# LLM_RETRY_MAX_WAIT_SECONDS=5    # longer Retry-After → go to the next provider instead

# Frontend variables live in frontend/.env.example (VITE_DATA_MODE, VITE_API_BASE_URL, VITE_SUPABASE_URL, ...).
