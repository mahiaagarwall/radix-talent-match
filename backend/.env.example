# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Supabase (used by app/db/supabase.py) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# --- Resume Parsing ---
# Free key: https://aistudio.google.com/apikey  (leave empty to use rule-based parsing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
# false = do not write parsed resumes to the database (e.g. before running sql/001_resume_tables.sql)
SAVE_PARSED_RESUMES=true
